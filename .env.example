# ============================================================
# SentinelFlow — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit your actual .env file to version control!
# ============================================================

# ------------------------------------------------------------
# 1. Threat Intelligence Providers
# ------------------------------------------------------------
# VirusTotal API v3 (https://www.virustotal.com/gui/my-apikey)
VT_API_KEY=your_virustotal_api_key_here

# AbuseIPDB API Key (https://www.abuseipdb.com/account/api)
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# Shodan API Key (https://account.shodan.io/)
SHODAN_API_KEY=your_shodan_api_key_here

# ------------------------------------------------------------
# 2. AI Reasoning Engines
# ------------------------------------------------------------
# Groq Cloud API Key for Llama 3.1 (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (optional for n8n workflow)
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------
# 3. Notification & SOC Dispatch
# ------------------------------------------------------------
# Discord Webhook URL (Channel Settings -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_discord_webhook_here

# Slack Bot User OAuth Token (optional for n8n workflow)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# Jira Software Cloud API (optional for n8n workflow)
JIRA_DOMAIN=yourcompany.atlassian.net
JIRA_USER_EMAIL=soc-alerts@yourcompany.com
JIRA_API_TOKEN=your_jira_api_token_here
